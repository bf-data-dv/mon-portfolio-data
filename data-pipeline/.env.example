# ==============================================================================
# CONFIGURATION SUPABASE (PROD / INFRA)
# ==============================================================================
SUPABASE_URL=https://votre_projet_id.supabase.co
SUPABASE_KEY=votre_cle_anon_ou_public_ici

# ==============================================================================
# CONFIGURATION AMAZON WEB SERVICES (AWS)
# ==============================================================================
# Identifiant de clé d'accès (20 caractères, commence souvent par AKIA)
AWS_ACCESS_KEY_ID=votre_aws_access_key_id_ici

# Clé d'accès secrète (40 caractères)
AWS_SECRET_ACCESS_KEY=votre_aws_secret_access_key_ici

# Région AWS par défaut pour le stockage S3 et les fonctions Lambda (ex: eu-west-3 pour Paris)
AWS_DEFAULT_REGION=eu-west-3